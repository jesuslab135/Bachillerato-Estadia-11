# Copia a .env y ajusta. Puerto 5433 para no chocar con un Postgres local en 5432.
DATABASE_URL="postgresql://sga:sga_dev@localhost:5433/sga_militar?schema=public"

# Auth (I3)
JWT_SECRET="cambia-esto-en-produccion"
JWT_EXPIRES_IN="8h"          # RF-AUTH-01
AUTH_MAX_INTENTOS="5"        # RF-AUTH-05
AUTH_BLOQUEO_MINUTOS="15"    # RF-AUTH-05
SEED_PASSWORD="SgaTemporal2026!"

# Seguridad (I10, RNF-SEC)
CORS_ORIGIN=""               # orígenes permitidos separados por coma; vacío = refleja el origen (dev)
THROTTLE_TTL="60000"         # ventana de rate-limit en ms
THROTTLE_LIMIT="1000"        # solicitudes por IP por ventana
