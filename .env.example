# Copia a .env y ajusta. Puerto 5433 para no chocar con un Postgres local en 5432.
DATABASE_URL="postgresql://sga:sga_dev@localhost:5433/sga_militar?schema=public"

# Auth (I3)
# JWT_SECRET es OBLIGATORIO: el proceso NO arranca sin él (FB-B-5, fail-fast).
JWT_SECRET="cambia-esto-en-produccion"
JWT_EXPIRES_IN="8h"          # RF-AUTH-01
AUTH_MAX_INTENTOS="5"        # RF-AUTH-05
AUTH_BLOQUEO_MINUTOS="15"    # RF-AUTH-05
SEED_PASSWORD="SgaTemporal2026!"

# Seguridad (I10, RNF-SEC + FB-B-5)
# CORS: lista de orígenes permitidos separados por coma. Vacío/omitido:
#   - en producción (NODE_ENV=production) NO se habilita CORS (ningún origen se refleja);
#   - en desarrollo se refleja el origen (modo permisivo).
CORS_ORIGIN=""
THROTTLE_TTL="60000"         # ventana de rate-limit global en ms
THROTTLE_LIMIT="1000"        # solicitudes por IP por ventana (global)
# Límite propio de POST /auth/login (anti fuerza bruta). Producción: ~10/min.
# Los e2e hacen varios logins reales por archivo: en dev/test se deja holgado (30).
THROTTLE_LOGIN_LIMIT="10"
THROTTLE_LOGIN_TTL="60000"
