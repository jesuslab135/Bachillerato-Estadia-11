# /opt/sga/.env.backend — entorno del backend en producción (NO subir valores reales).
# "postgres" es el nombre del servicio en la red interna de docker compose.
DATABASE_URL="postgresql://sga:MISMO_POSTGRES_PASSWORD@postgres:5432/sga_militar?schema=public"
NODE_ENV="production"
PORT="3000"

# Auth
JWT_SECRET="genera-uno-largo: openssl rand -hex 48"
JWT_EXPIRES_IN="8h"
AUTH_MAX_INTENTOS="5"
AUTH_BLOQUEO_MINUTOS="15"
SEED_PASSWORD="contraseña-temporal-del-seed"

# Seguridad
CORS_ORIGIN="https://app.jesuslab135.com"
# Detrás del nginx del compose hay exactamente 1 salto de proxy.
TRUST_PROXY="1"
THROTTLE_TTL="60000"
THROTTLE_LIMIT="1000"
THROTTLE_LOGIN_LIMIT="10"
THROTTLE_LOGIN_TTL="60000"
